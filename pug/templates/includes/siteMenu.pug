//- The Menu: every page, opened by the Menu button below the header bar, pushing the page down.
//- Top-level pages with the pages under them (api/helpers/siteNav.js); the page you're on is marked.
//- Needs `nav` (navState) from siteHeader.pug.
mixin siteMenuLink(link)
  - var here = link.key && link.key === nav.current
  a(href=link.href, class={ 'u-url': link.italic || link.me, 'site-menu-here': here }, rel=link.me ? 'me' : null, aria-current=here ? 'page' : null)
    if link.italic
      i #{link.text}
    else
      | #{link.text}
  if here
    span.site-menu-here-note  · you’re here

#site-menu.site-menu(hidden)
  each group in siteMenu
    ul.site-menu-group
      each top in group
        li.site-menu-top
          +siteMenuLink(top)
          if top.children
            ul.site-menu-children
              each child in top.children
                li
                  +siteMenuLink(child)
