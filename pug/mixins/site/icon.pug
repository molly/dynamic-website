//- Small line icons for the metadata column and filter chips. 14px, drawn in currentColor.
mixin siteIcon(name)
  svg.site-icon(viewBox="0 0 16 16", width="14", height="14", fill="none", stroke="currentColor", stroke-width="1.4", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true", focusable="false")
    case name
      when 'chat'
        path(d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z")
      when 'envelope'
        rect(x="2", y="3.5", width="12", height="9", rx="1")
        path(d="M2.5 4.5 8 8.5l5.5-4")
      when 'book'
        path(d="M8 4.5c-1.5-1-3.5-1.2-5.5-1v8.5c2-.2 4 0 5.5 1 1.5-1 3.5-1.2 5.5-1V3.5c-2-.2-4 0-5.5 1zM8 4.5v8.5")
      when 'quote'
        path(d="M3 9.5c0-2.5 1-4 3-5M3 9.5h2.5V12H3zM8.5 9.5c0-2.5 1-4 3-5M8.5 9.5H11V12H8.5z")
      when 'reply'
        path(d="M6 4 2.5 7.5 6 11M2.5 7.5h7a4 4 0 0 1 4 4v1")
      when 'live'
        circle(cx="8", cy="8", r="1.6", fill="currentColor")
        path(d="M5 5a4.2 4.2 0 0 0 0 6M11 5a4.2 4.2 0 0 1 0 6")
      when 'newspaper'
        rect(x="2.5", y="3", width="11", height="10", rx="1")
        path(d="M5 6h6M5 8.5h6M5 11h3.5")
      when 'speaker'
        path(d="M8 2.5a2 2 0 0 1 2 2v3.5a2 2 0 0 1-4 0V4.5a2 2 0 0 1 2-2zM4.5 7.5a3.5 3.5 0 0 0 7 0M8 11v2.5")
      when 'tv'
        rect(x="2", y="3.5", width="12", height="8.5", rx="1")
        path(d="m7 6 2.5 1.75L7 9.5z")
      when 'pen'
        path(d="M10.5 3 13 5.5 6 12.5H3.5V10z")
      when 'rss'
        path(d="M3.5 3.5a9 9 0 0 1 9 9M3.5 7a5.5 5.5 0 0 1 5.5 5.5")
        circle(cx="4", cy="12", r="0.8", fill="currentColor")
      default
        circle(cx="8", cy="8", r="2", fill="currentColor")
