//- One entry on the redesigned pages: the post on the left, its metadata column on the right (on a
//- phone, the verb line above the post and the rows below it). entryMeta (api/helpers/entryMeta.js)
//- works out the verb, date and rows.
include ./icon.pug
include ../shortformArticle.pug
include ../pressArticle.pug

mixin entryRowLink(row, item)
  a(href=item.href, class=item.className || (row.label === 'tags' ? 'p-category' : null), rel=row.label === 'tags' ? 'tag' : null)
    if item.italic
      i #{item.text}
    else
      | #{item.text}

mixin entryRows(meta, options)
  - var showEdit = options.isLoggedIn && meta.editUrl
  if meta.rows.length || showEdit
    dl.entry-rows
      each row in meta.rows
        .entry-row
          dt #{row.label}
          dd
            each item, index in row.items
              if index > 0
                | #{row.separator || ' · '}
              if item.html
                != item.html
              else if item.href
                if item.count
                  //- A tag and its count wrap together, never apart
                  span.entry-tag
                    +entryRowLink(row, item)
                    span.entry-tag-count  #{item.count}
                else
                  +entryRowLink(row, item)
              else if item.italic
                i #{item.text}
              else
                | #{item.text}
      if showEdit
        .entry-row
          dt
          dd
            a.entry-edit(href=meta.editUrl) edit

mixin microBody(micro, meta, options)
  - var isLive = micro.live && micro.live.status
  if micro.title
    h2.entry-title.p-name
      if options.isPermalink
        | #{micro.title}
      else
        a(href=meta.date.href) #{micro.title}
  if meta.replyTo
    p.entry-reply
      +siteIcon('reply')
      |  in reply to #[a.u-in-reply-to(href=meta.replyTo.url) #{meta.replyTo.name}]
      if meta.replyTo.networkLabel
        |  on #{meta.replyTo.networkLabel}
      if meta.replyTo.date
        |  · #{meta.replyTo.date}
  if isLive
    +liveBody(micro, meta, options)
  else
    //- In the feed a long post shows its start, then "continue reading →"
    //- (api/helpers/feedExcerpt.js).
    - var excerpt = options.isPermalink ? { html: micro.html, truncated: false } : feedExcerpt(micro)
    .entry-content.e-content
      each block in excerpt.html
        != block
    if excerpt.truncated
      //- The top of the next block, faded out. Not part of the post's content (no e-content),
      //- and not clickable or focusable: "continue reading →" is the way on.
      if excerpt.next
        .entry-content.entry-teaser(aria-hidden="true", inert)
          != excerpt.next
      p.entry-continues
        a(href=meta.date.href) continue reading →
    else
      +microExtras(micro, micro.updates || [])

//- A live post: "Live coverage · ended · Oct 29, 5:30–5:52 pm EDT", then a timeline down a purple
//- rail, in time order: the first post, then each live update. In the feed, the first post and the
//- two latest updates, with a link to the ones in between.
mixin liveBody(micro, meta, options)
  - var liveUpdates = (micro.updates || []).filter((u) => u.kind === 'live')
  - var shown = options.isPermalink ? liveUpdates : liveUpdates.slice(-2)
  - var skipped = liveUpdates.length - shown.length
  .live-coverage(class=micro.live.status)
    p.live-coverage-head
      strong Live coverage
      if micro.live.status === 'updating'
        |  · #[span.entry-live-dot(aria-hidden="true") ●] updating · since #{micro.live.range}
        if micro.live.lastUpdateAt
          |  · last #[time(datetime=toISOWithoutMillis(micro.live.lastUpdateAt), data-local="update") #{updateTime(micro.live.lastUpdateAt, new Date())}]
      else
        |  · ended · #{micro.live.range}
    ol.live-timeline
      li.live-entry.live-original
        //- The post's own date (there's no "Started …" line above a live post); in the feed it
        //- links to the post
        p.update-time
          if options.isPermalink
            time.dt-published(datetime=toISOWithoutMillis(micro.createdAt), title=meta.date.title, data-local="update", data-ref=toISOWithoutMillis(micro.createdAt)) #{updateTime(micro.createdAt, micro.createdAt)}
          else
            a.u-url(href=meta.date.href)
              time.dt-published(datetime=toISOWithoutMillis(micro.createdAt), title=meta.date.title, data-local="update", data-ref=toISOWithoutMillis(micro.createdAt)) #{updateTime(micro.createdAt, micro.createdAt)}
        .entry-content.e-content
          each block in micro.html
            != block
      if skipped
        li.live-entry.live-skipped
          a(href=meta.date.href) #{skipped} earlier #{skipped === 1 ? 'update' : 'updates'} →
      each update in shown
        li.live-entry.live-update(id=`update-${update.id}`)
          p.update-time
            time(datetime=toISOWithoutMillis(update.at), title=update.timestamps.absoluteTime, data-local="update", data-ref=toISOWithoutMillis(micro.createdAt)) #{updateTime(update.at, micro.createdAt)}
          if update.headline
            h3.update-headline #{update.headline}
          .entry-content
            each block in update.html
              != block
  +microExtras(micro, (micro.updates || []).filter((u) => u.kind !== 'live'))

//- After a post: the articles it's related to as cards, then its updates and corrections.
mixin microExtras(micro, updates)
  - var related = (micro.relatedPosts || []).filter((r) => r.ref)
  //- Related articles, as cards after the post, with their summaries and excerpts
  if related.length
    .entry-content.entry-related
      each item in related
        != articleCard(item.ref, { archived: micro.archived || {}, excerpts: item.ref.excerpts || [], summary: true })
  if updates.length
    section.entry-updates
      each update in updates
        .entry-update(id=`update-${update.id}`, class=update.kind)
          p.update-meta
            span.update-label #{update.label}
            |  · 
            time(datetime=toISOWithoutMillis(update.at), title=update.timestamps.absoluteTime, data-local="update", data-ref=toISOWithoutMillis(micro.createdAt)) #{updateTime(update.at, micro.createdAt)}
          if update.headline
            h3.update-headline #{update.headline}
          .entry-content
            each block in update.html
              != block

//- "Followed up in Citation Needed": later newsletter issues in the entry's thread.
mixin followUps(feedMeta)
  - var issues = feedMeta.laterIssues
  aside.followups(id=`followed-up-${feedMeta.key}`)
    p.followups-head
      +siteIcon('envelope')
      |  Followed up in #[i Citation Needed] · #{issues.length} #{issues.length === 1 ? 'issue' : 'issues'} · #[time(datetime=toISOWithoutMillis(issues[0].createdAt), data-local="day") #{shortDate(issues[0].createdAt)}]
    .followups-issues
      each issue in issues
        a.followup(href=issue.href)
          if issue.image
            img(src=issue.image, alt=issue.imageAlt, loading="lazy")
          span.followup-text
            span.followup-title #{issue.title}
            if issue.dek
              span.followup-dek #{issue.dek}

//- A Citation Needed issue: its image beside a "Citation Needed" label, the headline and dek, then
//- links to read it and to subscribe.
mixin citationNeededBody(entry, meta)
  .entry-cn
    if entry.image
      a.entry-cn-image(href=meta.date.href, tabindex="-1", aria-hidden="true")
        img(src=entry.image, alt=entry.imageAlt || '', loading="lazy")
    div
      p.entry-cn-label Citation Needed
      h2.entry-title.p-name
        a.u-syndication(href=meta.date.href, rel="syndication") #{entry.title}
      if entry.excerpt
        .entry-dek.p-summary
          != entry.excerpt
      p.entry-cn-links
        a.entry-cn-read(href=meta.date.href) Read in Citation Needed →
        |  · #[a(href="https://www.citationneeded.news/signup/") subscribe]

//- Press: a line for coverage of you; cards for your own pieces, talks and appearances. Media is
//- linked out to, with a player only for a copy you host yourself (mediaUrl, audioUrl).
mixin pressBody(entry, meta)
  - var press = entry.press
  - var archive = entry.feedMeta && press.href ? entry.feedMeta.archived[press.href] : null
  - var date = press.date ? readDate(press.date) : null
  case press.kind
    when 'freelance'
      .press-card.press-freelance.h-cite
        if press.leadImage
          a.press-card-image(href=press.href, tabindex="-1", aria-hidden="true")
            img(src=press.leadImage, alt="", loading="lazy")
        div
          p.press-card-meta
            if press.work
              span.press-card-outlet.p-publication #{press.work}
              |  · 
            | by me
          p.press-card-title.p-name
            a.u-url(href=press.href) #{press.title}
          if archive
            p.press-card-foot #[a(href=archive) archived]
    when 'talk'
      if meta.press && meta.press.upcoming
        .press-upcoming.h-event
          p.press-upcoming-label Upcoming talk
          p.press-upcoming-title
            if press.href
              a.p-name.u-url(href=press.href) #{press.title}
            else
              span.p-name #{press.title}
            if press.work
              |  · #[span.p-location #{press.work}]
            if date
              |  · #{date}
          if press.location
            p.press-upcoming-location #{press.location}
      else
        +pressMedia(press)
        p.press-talk-title.p-name
          if press.href
            a.u-url(href=press.href) #{press.title}
          else
            | #{press.title}
        - var talkLinks = [press.work, date].filter(Boolean)
        p.press-links
          | #{talkLinks.join(' · ')}
          each link in [['slides', press.slidesUrl], ['transcript', press.transcriptUrl], ['YouTube', press.youtubeUrl]]
            if link[1]
              |  · #[a(href=link[1]) #{link[0]}]
    when 'podcast'
    when 'radio'
    when 'video'
    when 'tv'
      .press-card.press-appearance.h-cite
        if press.audioUrl
          audio.press-audio(controls, preload="none", src=press.audioUrl, aria-label=`Listen to ${press.title}`)
        +pressMedia(press)
        p.press-card-meta
          if press.work
            span.press-card-outlet.p-publication #{press.work}
          if press.author
            |  · with #{press.author}
          if press.episode
            |  · ep. #{press.episode}
        p.press-card-title.p-name
          a.u-url(href=press.href) #{press.title}
        - var length = press.duration ? formatDuration(press.duration) : null
        p.press-card-foot
          if length
            | #{length}
          if press.href
            | #{length ? ' · ' : ''}#[a(href=press.href) #{press.kind === 'podcast' || press.kind === 'radio' ? 'show page' : 'watch'}]
          if press.youtubeUrl
            |  · #[a(href=press.youtubeUrl) YouTube]
          if press.transcriptUrl
            |  · #[a(href=press.transcriptUrl) transcript]
          if archive
            |  · #[a(href=archive) archived]
    default
      p.press-line.h-cite
        | #{(meta.press && meta.press.rolePhrase) || 'In'} 
        if press.work
          i.p-publication #{press.work}
          | : 
        | “#[a.u-url.p-name(href=press.href) #{press.title}]”
        if press.author
          span.press-line-author  — #{press.author}

//- Your own copy of a talk or video, when there is one.
mixin pressMedia(press)
  if press.mediaUrl
    .press-video
      video(controls, preload="metadata", src=press.mediaUrl, poster=press.posterUrl, aria-label=press.title)
      if press.duration
        span.press-duration(aria-hidden="true") #{formatDuration(press.duration)}

//- A book: cover, series, title and "by Author · 2000 · 470 pages".
mixin bookBody(book, meta)
  .entry-book.h-cite
    if book.imageSrc
      a.entry-book-cover(href=meta.date.href, tabindex="-1", aria-hidden="true")
        img(src=book.imageSrc, alt="", loading="lazy")
    div
      if book.series
        p.entry-book-series
          i #{book.series}
          |  series
          if Number.isFinite(book.seriesNumber)
            | , book #{book.seriesNumber}
      h2.entry-book-title.p-name
        a(href=book.href || meta.date.href) #[i #{book.title}]
      if book.subtitle
        p.entry-book-subtitle #{book.subtitle}
      - var details = [book.author ? `by ${book.author}` : null, book.date ? String(book.date).slice(0, 4) : null, book.pages ? `${book.pages} pages` : null].filter(Boolean)
      if details.length
        p.entry-book-byline #{details.join(' · ')}

//- "Read · Oct 28 · 3": articles read on one day, one line each, across the whole width.
mixin readingGroup(group, options = {})
  section.reading-group(aria-label=`Read on ${group.dateText}`)
    p.reading-group-head
      +siteIcon('newspaper')
      |  Read · #{group.dateText}
      if group.entries.length > 1
        |  · #{group.entries.length}
    ul.reading-group-items
      each entry in group.entries
        - var article = entry.shortform
        - var archive = entry.feedMeta && entry.feedMeta.archived[article.href]
        li.h-cite
          if article.href
            a.u-url.p-name(href=article.href) “#{article.title}”
          else
            span.p-name “#{article.title}”
          if article.work
            |  — #[i.p-publication #{article.work}]
          else if article.author
            |  — #[span.p-author #{article.author}]
          span.reading-group-extra
            each tag in (entry.tags || []).filter((t) => t && t.text)
              |  · 
              a.p-category(href=`${options.tagBase || '/feed/tag'}/${tag.value}`, rel="tag") ##{tag.text.trim().toLowerCase().replace(/\s+/g, '-')}
            if archive
              |  · #[a(href=archive) archived]
            if options.isLoggedIn
              |  · #[a.entry-edit(href=`/feed/tagger/readingShortform/${entry._id}`) edit]

//- A page of the feed: entries, with neighbouring same-day reading grouped.
mixin feedList(entries, options = {})
  each item in groupReading(entries)
    if item.entryType === 'readingGroup'
      +readingGroup(item, options)
    else
      +siteEntry(item, options)

mixin siteEntry(entry, options = {})
  - var meta = entryMeta(entry, { tagBase: options.tagBase, isPermalink: options.isPermalink })
  if meta
    - var micro = entry.entryType === 'micro' ? entry.micro : (entry.entryType ? null : entry)
    //- A live post's "Live coverage" strip says when it started, so it has no "Started …" line; its
    //- first post's time carries the date and the link instead (liveBody)
    - var isLivePost = Boolean(micro && micro.live && micro.live.status)
    article.site-entry.h-entry(class=[`site-entry-${entry.entryType || 'micro'}`, meta.verb === 'Quoted' ? 'site-entry-quoted' : null, options.isPermalink ? 'site-entry-permalink' : null, isLivePost ? 'site-entry-live' : null])
      unless isLivePost
        p.entry-verb
          +siteIcon(meta.icon)
          span.entry-verb-word #{meta.verb}
          | #{' '}
          //- On the post's own page the permalink row has the link (and the u-url), so the date isn't one
          if meta.rows.some((row) => row.label === 'permalink')
            time.dt-published.entry-verb-date(datetime=meta.date.iso, title=meta.date.title, data-local=meta.date.format) #{meta.date.text}
          else
            a.u-url(href=meta.date.href)
              time.dt-published(datetime=meta.date.iso, title=meta.date.title, data-local=meta.date.format) #{meta.date.text}
      .entry-main
        if micro
          +microBody(micro, meta, options)
        else
          case entry.entryType
            when 'citationNeeded'
              +citationNeededBody(entry, meta)
            when 'readingShortform'
              .entry-content
                +shortformArticle(entry.shortform, false, true)
            when 'readingBook'
              +bookBody(entry.book, meta)
            when 'press'
              +pressBody(entry, meta)
        if entry.feedMeta && entry.feedMeta.laterIssues.length
          +followUps(entry.feedMeta)
      +entryRows(meta, options)
