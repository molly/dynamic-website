extends ../templates/site.pug

block vars
  - var htmlClass = 'home'
  - var navCurrent = 'home'
  - var headerVariant = 'home'

block head
  include ../templates/titleAndDescription.pug
  +titleAndDescription("Molly White", "Molly White is a researcher, software engineer, and writer who focuses on the cryptocurrency industry, blockchains, web3, and tech more broadly.")

block body
  main#main.site-main.h-feed
    a.hidden(href="https://www.mollywhite.net/about", class="p-author u-author", rel="author") Molly White
    include ../includes/feedControls.pug
    include ../mixins/site/entry.pug
    +feedList(entries, options)
    //- The homepage is the feed's first page; the pager goes on to the feed's
    - var currentPage = 1
    - var pageBase = '/feed?'
    include ../includes/pager.pug
