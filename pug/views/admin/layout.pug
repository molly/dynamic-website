- var importPrefix = 'https://www.mollywhite.net'

doctype html
html(class='feed-editor', lang='en')
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel='icon' href=`${importPrefix}/assets/images/icons/favicon.ico`)
    link(rel='stylesheet', href=`${importPrefix}/assets/styles/base-styles.css`)
    link(rel='stylesheet', href="/static/editor.css")
    meta(name='theme-color', content='#191919')
    include ../../templates/titleAndDescription.pug
    +titleAndDescription(title ? `${title} · Admin` : 'Admin', "Site admin")

  //- The editor's shell (top bar, then the page), as in the post editor. Pages fill topbarLeft and
  //- topbarRight, and either content (a single column) or body (their own layout).
  //- micro-editor: the editor's variables, and room for the fixed action bar
  body.micro-editor(data-page=adminPage)
    .editor-shell
      header.editor-topbar
        .topbar-group
          block topbarLeft
            span admin
        .topbar-group
          block topbarRight
          nav.admin-nav(aria-label="Admin")
            a(href="/admin/entities", aria-current=adminPage === 'entities' ? 'page' : null) entities
            a(href="/admin/threads", aria-current=adminPage === 'threads' ? 'page' : null) threads
            a(href="/feed") feed
            a(href="/micro/editor") new post
      block body
        .admin-body
          block content
    if pageData
      script#page-data(type="application/json") !{JSON.stringify(pageData).replace(/</g, '\\u003c')}
    //- Pages with their own script (the tagger) replace this
    block scripts
      script(src="/static/admin.js")
