extends ../templates/site.pug

//- The press page, redesigned: an intro and contact details for journalists, then press and other
//- mentions with tag chips, search and sort, by month. Filters are plain links and a form
//- (frontend/routes/pressRouter.js, api/helpers/pressList.js), so the page needs no script.

block vars
  - var htmlClass = 'press-page'
  - var navCurrent = 'press'

block head
  include ../templates/titleAndDescription.pug
  +titleAndDescription('Press', 'Press mentions and interviews with Molly White.')

block body
  include ../mixins/site/listControls.pug
  main#main.site-main.list-layout.h-feed
    .list-main
      header.list-head
        p.entity-type-label Work
        h1.list-title.p-name Press
        p.list-intro.p-summary
          | I regularly speak about topics including technology, cryptocurrency, Wikipedia, and the
          | web. This list contains articles and various other media where I’ve done an interview or
          | spoken with the author(s), as well as ones that just mention my work.

      section.press-list(aria-labelledby="press-list-heading")
        h2#press-list-heading.press-list-heading Press and other mentions

        nav.press-tags(aria-label="Tags")
          ul
            each chip in chips.shown
              li
                a.press-tag(href=chip.href, aria-current=chip.current ? 'true' : null)
                  | #{chip.text}
                  span.press-tag-count #{chip.count}
          if chips.more.length
            details.press-more-tags
              summary + #{chips.more.length} more tags
              ul
                each chip in chips.more
                  li
                    a.press-tag(href=chip.href, aria-current=chip.current ? 'true' : null)
                      | #{chip.text}
                      span.press-tag-count #{chip.count}

        +listControls({ action: '/press', id: 'press-search', label: 'Search press', hidden: { tags: query.tags.join('-'), order: query.order }, search: query.search, placeholder: 'Search outlets, authors, headlines…', totalResults, isFiltered, clearHref, newestHref, oldestHref, order: query.order })

        if !months.length
          p.empty Nothing matches that.
        each month in months
          section.press-month
            h3.press-month-heading #{month.label}
            ul.list-entries
              each article in month.rows
                li.list-entry.h-entry
                  span.list-entry-date
                    if article.dayLabel
                      time.dt-published(datetime=article.date) #{article.dayLabel}
                  div
                    p.list-entry-meta
                      if article.work
                        span.list-entry-outlet.p-publication #{article.work}
                      if article.work && article.authorHtml
                        | #{' · '}
                      if article.authorHtml
                        span.p-author!= article.authorHtml
                    p.list-entry-title
                      a.u-url.p-name(href=article.href) #{article.title}
                    - var tags = (article.tags || []).filter((tag) => tag && tag.text)
                    - var archive = article.href ? archived[article.href] : null
                    if tags.length || archive
                      p.list-entry-foot
                        each tag, index in tags
                          if index > 0
                            | #{' · '}
                          a.p-category(href=tagHref(tag)) #{tagText(tag)}
                        if archive
                          | #{tags.length ? ' · ' : ''}#[a(href=archive) archived]

        include ../includes/pager.pug

    aside.list-side
      //- The press photo; it and the caption link to the high-resolution original
      - var pressPhotoHiRes = 'https://storage.mollywhite.net/Molly%20White.JPG'
      figure.press-photo
        a(href=pressPhotoHiRes)
          img(src="https://storage.mollywhite.net/Molly%20White%201000.webp", width="1000", height="563", alt="Molly White, with long hair shaved on one side, in a grey sweater, in front of white shelves.")
        figcaption
          | Press photo, licensed
          | #[a(href="https://creativecommons.org/licenses/by/4.0/", rel="license") CC BY 4.0].
          | #[a(href=pressPhotoHiRes) High-res version]
      .press-contact
        p.press-contact-label For journalists
        p
          | Email #[a(href="mailto:molly@mollywhite.net") molly@mollywhite.net], contact me on
          | #[a(href="https://signal.me/#eu/EvSDonMbzo7UATFs7zYAiYPVY3Z07TR7WM6Oef6YABM2sIerozNFWIy_wGTm03a3") Signal],
          | or get in touch #[a(href="https://www.mollywhite.net/verify/") another way].
