extends ../../templates/site.pug

block vars
  - var htmlClass = 'micro micro-entry'
  - var navCurrent = 'feed'

block head
  include ../../templates/titleAndDescription.pug
  +titleAndDescription(entry.title, entry.plainText || "Entry in Molly White's microblog", null, entry.image)

block body
  main#main.site-main
    include ../../mixins/site/entry.pug
    +siteEntry(entry, { ...options, isPermalink: true })

    //- Responses keep their current form until the post page step.
    section.entry-responses
      - var webmentions = entry.webmentions
      if webmentions
        each type of ['likes', 'bookmarks', 'reposts']
          - var webmentionsOfType = webmentions[type] || []
          if webmentionsOfType.length
            p(class=type)
              | #{type.charAt(0).toUpperCase() + type.slice(1).replace(/e?s$/, 'ed')} by 
              each webmention, index in webmentionsOfType
                a(href=webmention.source, title=webmention.body.author, rel="nofollow") #{webmention.body.author}
                if index !== webmentionsOfType.length - 1
                  | , 
        if webmentions.withContent && webmentions.withContent.length
          .replies
            each reply in webmentions.withContent
              .u-comment.h-cite #[a.u-url(href=reply.source, rel="nofollow") #{reply.body.type ? reply.body.type.charAt(0).toUpperCase() + reply.body.type.slice(1) : "Reply"}] by #[a.u-author.h-card(href=reply.body.authorUrl, rel="nofollow") #{reply.body.author}]
                if reply.body.published
                  |  on #[time.dt-published(datetime=toISOWithoutMillis(reply.body.published)) #{webmentionTimestamp(reply.body.published)}]
                if reply.body.summary
                  .p-summary
                    != reply.body.summary
                    |  ...
                else
                  .p-content
                    != reply.body.content

      .webmention-submit
        label(for="webmention-manual") Wrote about this on your site? Send a #[a(href="https://indieweb.org/Webmention") webmention]:
        .submit-box
          input#webmention-manual(type="url", placeholder="https://your-site.example/post", name="source", required)
          button#webmention-manual-submit(type="button") Send
        p.webmention-note Webmentions are moderated, so they won’t appear right away.
        #submit-error.hidden(role="alert")
        #submit-success.hidden(role="status")

    nav.pager(aria-label="More")
      a(href="/feed") ← the feed
