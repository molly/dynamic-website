- var importPrefix = 'https://www.mollywhite.net'
- var socialNetworks = [{ id: 'bluesky', label: 'Bluesky' }, { id: 'mastodon', label: 'Mastodon' }, { id: 'twitter', label: 'Twitter' }]

html(class='feed-editor', lang='en')
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel='icon' href=`${importPrefix || ''}/assets/images/icons/favicon.ico`)
    link(rel='icon' href=`${importPrefix || ''}/assets/images/icons/favicon-16x16.png` sizes='16x16' type='image/png')
    link(rel='icon' href=`${importPrefix || ''}/assets/images/icons/favicon-32x32.png` sizes='32x32' type='image/png')
    link(rel='apple-touch-icon' href=`${importPrefix || ''}/assets/images/icons/apple-touch-icon.png` sizes='180x180')
    link(rel='manifest', href=`${importPrefix || ''}/site.webmanifest`)
    link(rel='stylesheet', href=`${importPrefix || ''}/assets/styles/base-styles.css`)
    link(rel='stylesheet', href="/static/editor.css")
    meta(name='theme-color', content='#191919')
    include ../../templates/titleAndDescription.pug
    +titleAndDescription('Editor', "Micro post editor")
    block head

  body.micro-editor
    #loading-overlay.overlay
      include ../../includes/loadingSpinner
    #error-overlay.overlay.hidden
      .flex-column
        h1 Error
        p.error-message

    .editor-shell
      header.editor-topbar
        .topbar-group
          a(href="/feed") ← all posts
          span.topbar-separator ·
          span#editing-label new post
        .topbar-group
          span#last-saved
          a#preview-link(href="#", target="_blank", hidden) preview
          button#signOut.link-button(type="button") sign out

      .editor-body
        main.editor-writing
          div.editor-tabs(role="tablist", aria-label="Post and platform threads")
            button.editor-tab(type="button", role="tab", data-tab="post", aria-selected="true") Post
            each network in socialNetworks
              button.editor-tab(type="button", role="tab", data-tab=network.id, aria-selected="false")
                | #{network.label}
                span.tab-count(id=`${network.id}-count`)
            button.editor-tab.side-by-side-tab(type="button", role="tab", data-tab="side-by-side", aria-selected="false") side by side

          section#panel-post.tab-panel
            input#title(type="text", placeholder="Post title", aria-label="Title")
            #editorjs
            p#word-count.word-count

            section.updates-section(aria-labelledby="updates-heading")
              .updates-header
                h2#updates-heading Updates and corrections
                .updates-add
                  button.link-button(type="button", data-add-update="update") + update
                  button.link-button(type="button", data-add-update="correction") + correction
                  button#add-live-update.link-button(type="button", data-add-update="live", hidden) + live update
              p#corrections-prompt.corrections-prompt(hidden)
              #updates-list

          section#panel-social.tab-panel(hidden)
            #platform-thread
            #side-by-side(hidden)

        aside.editor-side-panel
          #platform-panel(hidden)
          #post-panel
            .side-section
              span.side-label Address
              p.address
                | /micro/entry/
                span#slug-display
                button#slug-edit.link-button(type="button") edit
              input#slug(type="text", hidden, aria-label="Slug")

            .side-section
              label.side-label(for="tags") Tags
              input#tags(autocomplete="off")

            .side-section
              label.side-label(for="threads") Threads
              input#threads(autocomplete="off")
              #threads-preview.picker-preview

            .side-section
              label.side-label(for="about")
                | About
                span.side-hint  · people & things mentioned
              input#about(autocomplete="off")

            .side-section
              label.side-label(for="related") Related posts
              select#related(multiple)

            .side-section
              .crosspost-header
                span.side-label Sources
                button#sources-suggest.link-button(type="button") suggest
              ul#sources-list.meta-rows
              #sources-suggestions.sources-suggestions
              button#sources-add.link-button(type="button") + add source

            .side-section
              span.side-label Data
              .meta-row
                input#data-label(type="text", placeholder="label", aria-label="Data label")
                input#data-url(type="url", placeholder="https://", aria-label="Data URL")

            .side-section
              .crosspost-header
                label.side-label(for="reply-url") In reply to
                button#reply-clear.link-button(type="button") clear
              input#reply-url(type="url", placeholder="paste a Bluesky, Mastodon or Twitter post")
              p#reply-status.side-hint
              #reply-details.reply-details(hidden)
                input#reply-name(type="text", placeholder="their name", aria-label="Their name")
                select#reply-network(aria-label="Network")
                input#reply-posted(type="datetime-local", aria-label="When they posted")

            .side-section
              .crosspost-header
                span.side-label Live
                label.switch
                  input#live-toggle(type="checkbox", role="switch")
                  span.switch-track(aria-hidden="true")
                  span.switch-label live post
              #live-details.live-details(hidden)
                select#live-status(aria-label="Live status")
                  option(value="updating") updating
                  option(value="ended") ended
                label.side-hint(for="live-started") started
                input#live-started(type="datetime-local")

            .side-section.archive-links
              .crosspost-header
                span.side-label Links
                button#archive-all.link-button(type="button", hidden) archive all
              ul#archive-list
              p.side-hint ticked links are archived when you save

            .side-section.crosspost-box
              .crosspost-header
                span.side-label Cross-post
                label.switch
                  input#crosspost-all(type="checkbox", role="switch")
                  span.switch-track(aria-hidden="true")
                  span.switch-label all platforms
              each network in socialNetworks
                label.crosspost-row
                  input.crosspost-toggle(type="checkbox", id=`${network.id}-social`, data-network=network.id)
                  span.crosspost-name #{network.label}
                  span.crosspost-status(id=`${network.id}-status`)
              p.side-hint edit each in its tab above the text
              details.social-links
                summary.side-hint Already posted? Link existing post IDs
                each network in [{ id: 'bluesky', label: 'Bluesky' }, { id: 'mastodon', label: 'Mastodon' }, { id: 'twitter', label: 'Twitter' }, { id: 'threads', label: 'Threads' }, { id: 'youtube', label: 'YouTube' }, { id: 'tiktok', label: 'TikTok' }]
                  .post-id-row
                    label(for=network.id) #{network.label}
                    input.social-post-id(id=network.id, type="text", placeholder="post ID", autocomplete="off")

      footer.editor-actionbar
        button#delete-button.link-button(type="button", hidden) delete post
        button#save-button.primary(type="button") Publish

    dialog#repost-dialog.confirm-dialog
      form(method="dialog")
        h2 Already posted
        p
          | This post is already on 
          strong#repost-networks
          | . Saving with them ticked will post it there again.
        .dialog-buttons
          button.link-button(type="submit", value="cancel") Cancel
          button(type="submit", value="skip") Save without re-posting
          button.primary(type="submit", value="repost") Post again

    script(src="/static/editor.js")
