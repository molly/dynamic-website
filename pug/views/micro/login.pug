extends ../../templates/site.pug

//- Logging in to post (the editor is behind it).

block vars
  - var htmlClass = 'status-page'

block head
  include ../../templates/titleAndDescription.pug
  +titleAndDescription('Log in', 'Log in to post.')
  meta(name="robots", content="noindex")

block body
  main#main.site-main.status-main
    p.entity-type-label Microblog
    h1.list-title Log in
    form.login-form(action="/dynamic-api/auth/login", method="POST")
      label(for="username") Username
      input#username(type="text", name="username", autocomplete="username", required, autofocus)
      label(for="password") Password
      input#password(type="password", name="password", autocomplete="current-password", required)
      input(type="hidden", name="redirect", value="/micro/editor")
      button(type="submit") Log in
