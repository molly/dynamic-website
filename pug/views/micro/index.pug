extends ../../templates/site.pug

block vars
  - var htmlClass = 'micro'
  - var navCurrent = 'feed'

block head
  include ../../templates/titleAndDescription.pug
  +titleAndDescription('Micro feed', "Feed of Molly White's microblog posts")

block body
  main#main.site-main.h-feed
    if options.tagQuery
      h1.page-title.p-name Posts tagged #[span.page-title-tag ##{options.tag ? options.tag.text : options.tagQuery}]
      p.page-subtitle #[a(href="/micro") ← all posts]
    else
      h1.page-title.p-name Posts
      p.page-subtitle.p-summary Short thoughts, notes, links, and musings by #[a(href="https://www.mollywhite.net/about", class="p-author u-author", rel="author") Molly White]. #[a(href="https://www.mollywhite.net/micro/feed.xml", rel="alternate", type="application/rss+xml") rss]

    if options.hasResults === false
      p.empty No posts with that tag. #[a(href="/micro") See all posts].
    else
      include ../../mixins/site/entry.pug
      each entry in entries
        +siteEntry(entry, { ...options, tagBase: '/micro/tag' })

    - var pageBase = options.tagQuery ? `/micro/tag/${options.tagQuery}?` : '/micro?'
    include ../../includes/pager.pug
