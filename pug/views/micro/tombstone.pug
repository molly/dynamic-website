extends ../../templates/site.pug

//- A micro post that's been deleted: when it was published and when it went, with its address
//- kept so links to it still say what happened.

block vars
  - var htmlClass = 'status-page'
  - var navCurrent = 'feed'

block head
  include ../../templates/titleAndDescription.pug
  +titleAndDescription('Post deleted', 'This post has been deleted.')
  meta(name="robots", content="noindex")

block body
  main#main.site-main.status-main.h-entry
    p.entity-type-label Deleted post
    h1.list-title This post is gone
    p.list-intro
      | It was published
      |  #[a.u-url(href=`/micro/entry/${entry.slug}`) #[time.dt-published(datetime=new Date(entry.createdAt).toISOString()) #{shortDate(entry.createdAt)}]]
      if entry.deletedAt
        |  and deleted
        |  #[time.dt-deleted(datetime=new Date(entry.deletedAt).toISOString()) #{shortDate(entry.deletedAt)}]
      | .
    ul.status-links
      li #[a(href="/feed") Feed]
      li #[a(href="/micro") Microblog]
