extends ../../templates/site.pug

block vars
  - var htmlClass = 'feed'
  - var navCurrent = 'feed'

block head
  include ../../templates/titleAndDescription.pug
  if options.tagQuery
    +titleAndDescription(`Feed: #${options.tag ? options.tag.text : options.tagQuery}`, "Molly White's activity feed")
  else
    +titleAndDescription('Feed', "Molly White's activity feed")

block body
  main#main.site-main.h-feed
    a.hidden(href="https://www.mollywhite.net/about", class="p-author u-author", rel="author") Molly White
    if options.tagQuery
      h1.page-title.p-name Tagged #[span.page-title-tag ##{options.tag ? options.tag.text : options.tagQuery}]
      p.page-subtitle #[a(href="/feed") ← all of the feed]
    else
      h1.page-title.p-name.visually-hidden Feed
      include ../../includes/feedControls.pug

    if options.hasResults === false
      p.empty No entries with that tag. #[a(href="/feed") See the whole feed].
    else
      include ../../mixins/site/entry.pug
      +feedList(entries, options)

    - var pageBase = options.tagQuery ? `/feed/tag/${options.tagQuery}?` : (activeFilter ? `/feed?type=${activeFilter}&` : '/feed?')
    include ../../includes/pager.pug
