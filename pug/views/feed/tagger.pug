extends ../admin/layout.pug

//- The tagger: tags, threads and "about" for a feed entry that isn't a micro post (a newsletter
//- issue, reading or press), in the editors' shell. The main column shows the entry like an
//- editor's head (kind, title, where it's from) and the fields particular to its kind; the side
//- panel has the metadata, as in the post editor; Save is in the fixed bar. The fields are wired up
//- by frontend/js/tagger.js.

block topbarLeft
  a(href=feedHref) ← all posts
  span.topbar-separator ·
  span tagging #{header.kind}

block topbarRight
  span#last-saved.admin-status(role="status")
  if header.href
    a(href=header.href) original ↗

block body
  .editor-body.tagger
    main.tagger-main
      p.entity-editor-type #{header.label}
      h1.tagger-title
        if header.href
          a(href=header.href) #{header.title || 'Untitled'}
        else
          | #{header.title || 'Untitled'}
      p.tagger-source
        each part, index in header.source
          if index > 0
            | #{' · '}
          if part.italic
            i #{part.text}
          else
            | #{part.text}
      if header.blurb
        .tagger-blurb!= header.blurb
      p#tagger-error.entity-error(hidden, role="alert")

      if entryType == "press"
        - var durationText = (seconds) => { if (!seconds && seconds !== 0) return ''; const t = Math.round(seconds); const h = Math.floor(t / 3600); const m = Math.floor((t % 3600) / 60); const sec = String(t % 60).padStart(2, '0'); return h ? `${h}:${String(m).padStart(2, '0')}:${sec}` : `${m}:${sec}` }
        //- A URL field, with an upload beside it when the file can be one of yours
        mixin urlField(name, label, kinds, accept)
          .entity-field-row(data-kinds=kinds)
            label(for=`press-${name}`) #{label}
            .tagger-url
              input(id=`press-${name}`, type="url", value=press[name] || '', placeholder="https://")
              if accept
                label.link-button.upload-button upload#[input.press-upload(type="file", accept=accept, data-target=`press-${name}`, hidden)]

        section#press-fields.entity-editor-section
          h2.entity-editor-heading Press card
          .entity-field-row
            label(for="press-kind") kind
            select#press-kind
              each kind in pressKinds
                option(value=kind, selected=press.kind === kind) #{pressKindNames[kind] || kind}
          .entity-field-row(data-kinds="article podcast radio video tv talk")
            label(for="press-role") your part
            select#press-role
              option(value="", selected=!press.role) —
              each role in pressRoles
                option(value=role, selected=press.role === role) #{role}
          +urlField('leadImage', 'lead image', 'freelance', 'image/*')
          .entity-field-row(data-kinds="talk podcast radio video tv")
            label(for="press-duration") length
            input#press-duration(type="text", value=durationText(press.duration), placeholder="52:30 or 1:02:30", inputmode="numeric")
          .entity-field-row(data-kinds="podcast radio video tv talk")
            label(for="press-people") with
            input#press-people(autocomplete="off")
          .entity-field-row(data-kinds="podcast radio")
            label(for="press-episode") episode
            input#press-episode(type="text", value=press.episode || '', placeholder="426")
          .entity-field-row(data-kinds="talk")
            label(for="press-location") location
            input#press-location(type="text", value=press.location || '', placeholder="for an upcoming talk")
          +urlField('slidesUrl', 'slides', 'talk')
          +urlField('transcriptUrl', 'transcript', 'talk podcast radio video tv')
          +urlField('youtubeUrl', 'YouTube', 'talk video tv')

          details.tagger-own-copy(data-kinds="talk podcast radio video tv", open=Boolean(press.mediaUrl || press.audioUrl))
            summary.side-label
              | Your own copy
              span.side-hint  · gets a player on the site
            +urlField('mediaUrl', 'video', 'talk video tv', 'video/*')
            +urlField('posterUrl', 'poster', 'talk video tv', 'image/*')
            +urlField('audioUrl', 'audio', 'podcast radio', 'audio/*')
          p#press-upload-status.field-help(hidden)

      if entryType == "citationNeeded"
        section.entity-editor-section
          h2.entity-editor-heading Already posted?
          p.field-help Link the issue’s posts by their IDs, for “discuss” on the site.
          each network in [{ id: 'twitter', label: 'Twitter' }, { id: 'mastodon', label: 'Mastodon' }, { id: 'bluesky', label: 'Bluesky' }, { id: 'threads', label: 'Threads' }, { id: 'youtube', label: 'YouTube' }, { id: 'tiktok', label: 'TikTok' }]
            - var socialLink = entry.socialLinks && entry.socialLinks.find((e) => e.type === network.id)
            .post-id-row
              //- Not the network's name as its id: "threads" is also the Threads picker's
              label(for=`post-id-${network.id}`) #{network.label}
              input.social-post-id(id=`post-id-${network.id}`, data-network=network.id, type="text", placeholder="post ID", autocomplete="off", value=socialLink ? socialLink.postId : '')

    aside.editor-side-panel
      .side-section
        label.side-label(for="tags") Tags
        input#tags(autocomplete="off", value=entry.tags.map((tag) => tag._id).join(','))

      .side-section
        label.side-label(for="threads") Threads
        input#threads(autocomplete="off")
        #threads-preview.picker-preview

      .side-section
        label.side-label(for="about")
          | About
          span.side-hint  · people & things it’s about
        input#about(autocomplete="off")

  footer.editor-actionbar
    span.side-hint shown with the entry in the feed
    button#save-button.primary(type="button") Save

  script#picker-data(type="application/json") !{JSON.stringify(pickerData).replace(/</g, '\\u003c')}

block scripts
  script(src="/static/tagger.js")
